# ==============================================================================
# AlphaWay Configuration File (.env)
# ==============================================================================

# 1. API Authentication & Secret Protection
# API_KEY / BRIDGE_API_KEY remain available as legacy environment-managed gateway credentials.
# Prefer creating and revoking hashed, one-time-display keys from the authenticated dashboard.
API_KEY=
BRIDGE_API_KEY=
# Optional 32-byte key encoded as 64 hex characters or base64. When unset, AlphaWay
# creates ~/.alphaway/secret-encryption.key with restrictive permissions. Back it up.
ALPHAWAY_ENCRYPTION_KEY=
# Set TRUST_PROXY=1 only behind a trusted reverse proxy that overwrites X-Forwarded-Proto.
TRUST_PROXY=0

# 2. Named Cloudflare Tunnel / Public Endpoint
# Public domain if AlphaWay is exposed through Cloudflare Tunnel (cloudflared).
# Allows tunnel Host/Origin headers and displays public Base URL on the dashboard.
PUBLIC_URL=

# Cloudflare Named Tunnel Credentials (Use either Token OR the 3 ID Variables)
# Option A: Tunnel Token
# CLOUDFLARE_TUNNEL_TOKEN=
# Option B: ID + Account Tag + Secret
# CLOUDFLARE_TUNNEL_ID=your-tunnel-uuid-here
# CLOUDFLARE_ACCOUNT_TAG=your-account-tag-here
# CLOUDFLARE_TUNNEL_SECRET=your-tunnel-secret-here

# 3. TokenSaver & DLP Security Engine (Adapted from 9router-go)
RTK_ENABLED=true
RTK_MAX_LINES=250
RTK_DEDUPLICATE=true
CAVEMAN_ENABLED=false
CAVEMAN_LEVEL=full
CAVEMAN_LANG=auto
CAVEMAN_AUTO_CLARITY=true
ADHD_ENABLED=false
ADHD_LEVEL=full
DLP_REDACTION=true

# 4. SOUL.md & Personality Engine (SoulSpec Standard)
# Injects persistent identity and behavioral constraints into all AI client requests
# Auto-loads ./SOUL.md or ~/.alphaway/SOUL.md; falls back to 'atlas' preset
SOUL_ENABLED=true
SOUL_MODE=auto
SOUL_PRESET=atlas
# SOUL_FILE=/path/to/custom/SOUL.md

# 5. Server Port & Network Binding
PORT=20129
HOST=127.0.0.1

# 6. Anti-Burst Concurrency Queue
# Prevents burst traffic that triggers upstream 429 FreeUsageLimitError
MAX_CONCURRENT_UPSTREAM=3
REQUEST_SPACING_MS=150

# 7. CodeBuddy International (WorkBuddy AI) Settings
# Optional legacy/environment override for the CodeBuddy upstream credential.
# Dashboard/CLI OAuth tokens are stored encrypted in SQLite using ALPHAWAY_ENCRYPTION_KEY.
CODEBUDDY_API_KEY=
# Gateway endpoint URL (default: https://www.workbuddy.ai/v2/chat/completions)
# CODEBUDDY_INTL_URL=https://www.workbuddy.ai/v2/chat/completions
# In-flight concurrency limit per account to prevent 11140 account restrictions (default: 3)
# CODEBUDDY_MAX_IN_FLIGHT=3

# 8. Allowed Panel Hosts (Optional comma-separated list of domains)
# PANEL_ALLOWED_HOSTS=gateway.example.com,ai.example.com
